# Długa, losowa wartość — wymagana w instalacji dostępnej w sieci.
ASOLAR_SECRET=zmien-ten-klucz-przed-wdrozeniem

# Hasła kont startowych (minimum 8 znaków). Konto powstaje tylko, jeśli jeszcze nie istnieje;
# hasła istniejących użytkowników nigdy nie są nadpisywane przy restarcie.
# Bez tych zmiennych hasła są losowane i zapisane w data/initial-passwords.txt (instalacja lokalna).
ASOLAR_MANAGER_PASSWORD=
ASOLAR_FOREMAN1_PASSWORD=
ASOLAR_FOREMAN2_PASSWORD=

# SQLite działa bez konfiguracji. PostgreSQL (postgres:// i postgresql:// są akceptowane):
# DATABASE_URL=postgresql://asolar:haslo@host:5432/asolar
ASOLAR_HOST=127.0.0.1
PORT=8765
